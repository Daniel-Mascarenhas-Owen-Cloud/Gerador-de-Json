         "purgeType": "YEARS",
         "pointLocator": {
            "dataType": "NUMERIC",
            "updateEvent": "WEEKS",
            "context": [
               {
                  "varName": "energy",
                  "dataPointXid": "MDN_CAL_Energia Anual 1 (GWh)"
               },
               {
                  "varName": "KWp",
                  "dataPointXid": "MDN_VIR_Capacidade Instalada 1 (KWp)"
               },
               {
                  "varName": "latitude",
                  "dataPointXid": "MDN_VIR_Latitude da Usina (graus)"
               },
               {
                  "varName": "longitude",
                  "dataPointXid": "MDN_VIR_Longitude da Usina (graus)"
               }
            ],
            "executionDelayPeriodType": "SECONDS",
            "executionDelaySeconds": 0,
            "script": "\n// DADOS \n\nvar lat = latitude.value;\nvar lon = longitude.value;\nvar capacity = (KWp.value / 1000000); // GWp\nvar energia = energy.value; // GWh ano acumulado\n\n// VALIDAÇÕES INICIAIS\n\nif (!capacity || capacity <= 0) return 0;\nif (!energia || energia < 0) energia = 0;\n\n// DATA\n\nvar agora = new Date();\nvar ano = agora.getFullYear();\nvar mesAtual = agora.getMonth();\nvar diaAtual = agora.getDate();\n\n\n// FUNÇÕES \n\nfunction rad(g) { return g * Math.PI / 180; }\nfunction deg(r) { return r * 180 / Math.PI; }\n\nfunction diaDoAno(data) {\n    var inicio = new Date(data.getFullYear(), 0, 0);\n    var diff = data - inicio;\n    return Math.floor(diff / (1000 * 60 * 60 * 24));\n}\n\nfunction duracaoSolarDia(data) {\n    var N = diaDoAno(data);\n    var decl = 23.45 * Math.sin(rad((360/365) * (284 + N)));\n    var cosW = -Math.tan(rad(lat)) * Math.tan(rad(decl));\n    \n    if (cosW > 1) cosW = 1;\n    if (cosW < -1) cosW = -1;\n    \n    var W = deg(Math.acos(cosW));\n    return (2 * W) / 15;\n}\n\n//  SOMA DAS HORAS SOLARES DESDE JANEIRO \n\nvar horasTotal = 0;\n\n// Meses completos\nfor (var m = 0; m < mesAtual; m++) {\n    var diasNoMes = new Date(ano, m + 1, 0).getDate();\n    for (var d = 1; d <= diasNoMes; d++) {\n        horasTotal += duracaoSolarDia(new Date(ano, m, d));\n    }\n}\n\n// Dias completos do mês atual\nfor (var d = 1; d < diaAtual; d++) {\n    horasTotal += duracaoSolarDia(new Date(ano, mesAtual, d));\n}\n\n\n// HORAS DO DIA ATUAL \n\nvar duracaoHoje = duracaoSolarDia(agora);\n\nvar fuso = -3;\nvar meridianoCentral = fuso * 15;\nvar correcaoLongitude = (lon - meridianoCentral) / 15;\nvar meioDiaSolar = 12 - correcaoLongitude;\n\nvar nascerSol = meioDiaSolar - duracaoHoje / 2;\nvar porSol = meioDiaSolar + duracaoHoje / 2;\n\nvar horaAtual = agora.getHours() + \n                agora.getMinutes()/60 + \n                agora.getSeconds()/3600;\n\nvar horasHoje;\n\nif (horaAtual <= nascerSol) {\n    horasHoje = 0;\n} \nelse if (horaAtual >= porSol) {\n    horasHoje = duracaoHoje;\n} \nelse {\n    horasHoje = horaAtual - nascerSol;\n}\n\nhorasTotal += horasHoje;\n\n\n// PROTEÇÃO FINAL \n\nif (horasTotal <= 0) return 0;\n\n\n// FC ANUAL\n\nvar FC = (energia / (capacity * horasTotal)) * 100;\n\n\n// CLAMP 0–100% \n\nif (isNaN(FC) || !isFinite(FC)) {\n    return 0;\n}\n\nif (FC > 100) FC = 100;\nif (FC < 0) FC = 0;\n\nreturn FC;",
            "settable": false,
            "updateCronPattern": ""
         },
