      {
         "xid": "MDN_CAL_Fator de Capacidade Diário 1",
         "loggingType": "INTERVAL",
         "intervalLoggingPeriodType": "MINUTES",
         "intervalLoggingType": "INSTANT",
         "purgeType": "YEARS",
         "pointLocator": {
            "dataType": "NUMERIC",
            "updateEvent": "MINUTES",
            "context": [
               {
                  "varName": "energy",
                  "dataPointXid": "MDN_Smart1_MED_Energia Diaria Total (KWh)"
               },
               {
                  "varName": "KWp",
                  "dataPointXid": "MDN_VIR_Capacidade Instalada 1 (KWp)"
               },
               {
                  "varName": "latitude",
                  "dataPointXid": "MDN_VIR_Latitude da Usina (graus)"
               },
               {
                  "varName": "longitude",
                  "dataPointXid": "MDN_VIR_Longitude da Usina (graus)"
               }
            ],
            "executionDelayPeriodType": "SECONDS",
            "executionDelaySeconds": 0,
            "script": "// DADOS DA USINA\n\nvar lat = latitude.value;      // graus\nvar lon = longitude.value;     // graus\nvar capacity = KWp.value;      // kWp\nvar energia = energy.value;    // kWh do dia\n\n// VALIDAÇÕES INICIAIS\n\nif (!capacity || capacity <= 0) return 0;\nif (!energia || energia < 0) energia = 0;\n\n// DATA ATUAL\n\nvar agora = new Date();\nvar ano = agora.getFullYear();\n\n// Dia do ano\nvar inicioAno = new Date(ano, 0, 0);\nvar diff = agora - inicioAno;\nvar umDia = 1000 * 60 * 60 * 24;\nvar N = Math.floor(diff / umDia);\n\n// Hora atual decimal\nvar horaAtual = agora.getHours() +\n                agora.getMinutes()/60 +\n                agora.getSeconds()/3600;\n\n\n// FUNÇÕES AUXILIARES\n\nfunction rad(g) { return g * Math.PI / 180; }\nfunction deg(r) { return r * 180 / Math.PI; }\n\n\n// DECLINAÇÃO SOLAR\n\nvar decl = 23.45 * Math.sin(rad((360/365) * (284 + N)));\n\n// ÂNGULO HORÁRIO\nvar cosW = -Math.tan(rad(lat)) * Math.tan(rad(decl));\n\n// Correção matemática\nif (cosW > 1) cosW = 1;\nif (cosW < -1) cosW = -1;\n\nvar W = deg(Math.acos(cosW));\n\n// Duração real do dia\nvar duracaoDia = (2 * W) / 15;\n\n\n// AJUSTE POR LONGITUDE (Brasil UTC-3)\n\nvar fuso = -3;\nvar meridianoCentral = fuso * 15;\nvar correcaoLongitude = (lon - meridianoCentral) / 15;\n\nvar meioDiaSolar = 12 - correcaoLongitude;\n\nvar nascerSol = meioDiaSolar - duracaoDia/2;\nvar porSol = meioDiaSolar + duracaoDia/2;\n\n\n// HORAS SOLARES DECORRIDAS\n\nvar horasSolares;\n\nif (horaAtual <= nascerSol) {\n    horasSolares = 0;\n} \nelse if (horaAtual >= porSol) {\n    horasSolares = duracaoDia;\n} \nelse {\n    horasSolares = horaAtual - nascerSol;\n}\n\n// Proteção\nif (horasSolares <= 0) return 0;\n\n\n// CÁLCULO DO FC\n\nvar FC = (energia / (capacity * horasSolares)) * 100;\n\n\n// CLAMP DE SEGURANÇA (0% a 100%)\n\nif (isNaN(FC) || !isFinite(FC)) {\n    return 0;\n}\n\nif (FC > 100) FC = 100;\nif (FC < 0) FC = 0;\n\nreturn FC;",
            "settable": false,
            "updateCronPattern": ""
         },
         "eventDetectors": [],
         "engineeringUnits": "",
         "purgeStrategy": "PERIOD",
         "chartColour": null,
         "chartRenderer": null,
