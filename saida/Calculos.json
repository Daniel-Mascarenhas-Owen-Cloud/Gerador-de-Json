      {
         "xid": "CED_CAL_Energia Esperada 1 (KWh)",
         "loggingType": "INTERVAL",
         "intervalLoggingPeriodType": "MINUTES",
         "intervalLoggingType": "INSTANT",
         "purgeType": "YEARS",
         "pointLocator": {
            "dataType": "NUMERIC",
            "updateEvent": "CONTEXT_UPDATE",
            "context": [
               {
                  "varName": "POA",
                  "dataPointXid": "CED_MED_Acumulado Diário - POA (Wh/m²)"
               },
               {
                  "varName": "Module1",
                  "dataPointXid": "CED_MED_Temperatura do Módulo 1 (°C)"
               },
               {
                  "varName": "Capacity",
                  "dataPointXid": "CED_VIR_Capacidade Instalada 1 (KWp)"
               }
            ],
            "executionDelayPeriodType": "SECONDS",
            "executionDelaySeconds": 0,
            "script": "// Entradas\nvar irrad = POA.value;       // Irradiação do dia em Wh/m²\nvar temp = Module1.value;     // Temperatura instantânea do módulo em °C\nvar KWp = Capacity.value;            // Potência pico do sistema em kW\nvar coef_temp = -0.0030;     // Coeficiente de temperatura (%/°C)\n\n// Energia esperada ajustada pela temperatura\nvar tempFactor = 1 + ((temp - 25) * coef_temp); // Fator de correção térmica\nvar expectedEnergy = irrad * KWp * tempFactor;  // em Wh\n\nreturn expectedEnergy/1000;  // Resultado em KWh\n",
            "settable": false,
            "updateCronPattern": ""
         },
         "eventDetectors": [],
         "engineeringUnits": "",
         "purgeStrategy": "PERIOD",
         "chartColour": null,
         "chartRenderer": null,
         "dataSourceXid": "CED_Dados Calculados",
