         "discardLowLimit": -1.7976931348623157E308,
         "enabled": false,
         "eventTextRenderer": {
            "type": "EVENT_NONE"
         },
         "intervalLoggingPeriod": 5,
         "name": "CED_CAL_Energia Esperada 1 (KWh)",
