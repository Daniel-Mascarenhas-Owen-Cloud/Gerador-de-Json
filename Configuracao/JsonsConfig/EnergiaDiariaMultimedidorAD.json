      {
         "xid": "USN_MM1_MED_Energia Ativa Exp. Diária (MWh)",
         "loggingType": "ON_TS_CHANGE",
         "intervalLoggingPeriodType": "MINUTES",
         "intervalLoggingType": "INSTANT",
         "purgeType": "YEARS",
         "pointLocator": {
            "dataType": "NUMERIC",
            "updateEvent": "CRON",
            "context": [
               {
                  "varName": "self",
                  "dataPointXid": "USN_MM1_MED_Energia Ativa Exp. Diária (MWh)"
               },
               {
                  "varName": "total",
                  "dataPointXid": "USN_MM1_CAL_Energia Ativa Exp. 5 min. (MWh)"
               }
            ],
            "executionDelayPeriodType": "SECONDS",
            "executionDelaySeconds": 15,
            "script": "var atual = total.value;\n\n// Valor persistido 5 minutos atrás\nvar anterior = total.ago(MINUTE, 5);\n\n// Valor atual do diário\nvar diario = self.value;\n\n// Inicialização\nif (diario == null || isNaN(diário))\n    diario = 0;\n\n// Sem histórico suficiente\nif (anterior == null || isNaN(anterior))\n    return diario;\n\n// Proteção contra regressão\nif (atual < anterior)\n    return diario;\n\n// Delta real\nvar delta = atual - anterior;\n\n// Ignora valores repetidos\nif (delta == 0)\n    return diario;\n\n// Ignora negativos\nif (delta < 0)\n    return diario;\n\n// Anti micro ruído\nif (delta < 0.00001)\n    return diario;\n\n// Anti salto absurdo\nif (delta > 5)\n    return diario;\n\n// Soma incremento\ndiario = diario + delta;\n\n// Limita precisão\ndiario = Math.round(diario * 1000000) / 1000000;\n\nreturn diario;",
            "settable": true,
            "updateCronPattern": "0 */5 * * * ?"
         },
